EDGE_PORT=4000
LOG_LEVEL=info
NODE_ENV=development
API_KEY=change-me-local-only

# Database (Postgres + pgvector via docker-compose)
DATABASE_URL=postgres://vipcam:vipcam@localhost:5432/vipcam

# Camera (preencher antes de rodar discovery)
# CAMERA_IP=192.168.1.108
# CAMERA_USER=admin
# CAMERA_PASS=

# ERP MySQL local (mesma máquina via 127.0.0.1)
# Preencher quando integração com ERP for ativada (Chunk 4 Onda 2)
# ERP_MYSQL_URL=mysql://erp_reader:senha@127.0.0.1:3306/barbearia_erp

# === ERP Queries (IMPORTANTE) ===
# Estas queries DEVEM retornar exatamente as colunas listadas no comentário.
# Use SQL "AS" para alias se seu schema usa nomes diferentes
# (ex: "SELECT cod AS id, nome AS name, ativo AS is_active FROM funcionarios").
# Boot do edge faz validateErpQueries() — falha hard se faltar coluna.
#
# Defaults assumem tabelas employees/clients/checkins com colunas comuns;
# uncomment + ajuste apenas se seu schema for diferente.
#
# ERP_QUERY_EMPLOYEES="SELECT id, name, role, photo_url, photo_updated_at, is_active FROM employees WHERE is_active = 1"
# ERP_QUERY_CLIENTS="SELECT id, name, phone, is_active FROM clients WHERE is_active = 1"
# ERP_QUERY_CHECKINS_SINCE="SELECT id, client_id, event_type, occurred_at, metadata FROM checkins WHERE occurred_at >= ? ORDER BY occurred_at"

# === Match temporal (Chunk 4) ===
# Janela ±N segundos em torno do checkin pra buscar detections anônimas
# candidatas. Default 300s (±5min). Reduzir em horários de pico se observar
# muitos ambíguos; aumentar se observar muitos rejected (cliente checkou in
# muito antes/depois de aparecer na câmera).
# MATCH_WINDOW_SECONDS=300

# Lookback inicial pro cursor de checkins quando cache local está vazio
# (greenfield deploy). Default 24h captura o dia de operação típico sem
# inundar com histórico antigo. Aumentar se ERP tem checkins antigos que
# valem ingerir; diminuir se ERP tem ruído antigo que não vale processar.
# ERP_CHECKINS_INITIAL_LOOKBACK_HOURS=24
