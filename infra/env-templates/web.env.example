# /etc/vipcam/web.env
# Lido pelo deploy.sh em BUILD time (Next inlina NEXT_PUBLIC_* no bundle)
# e pelo systemd unit vipcam-web.service em runtime.
# PORT=3035 vem do unit file (não duplicar aqui).
# Permissões: chmod 640 root:vipcam — contém a API key (mesmo que ela
# acabe no bundle público por design, o arquivo no servidor não deve
# ser world-readable; defense-in-depth + consistência com edge.env).

NODE_ENV=production

# URL pública pela qual o frontend chama a API. O nginx do mesmo host
# roteia /api/* e /snapshots/* para o edge, então é same-origin:
NEXT_PUBLIC_API_URL=https://monitoramento.franquiabv.com.br

# X-API-Key do edge — MESMO valor de API_KEY em /etc/vipcam/edge.env.
# Vai pro bundle JS (Onda 3: kiosk LAN-trancado, decisão consciente).
NEXT_PUBLIC_API_KEY=cole-aqui-a-mesma-chave-do-edge.env
