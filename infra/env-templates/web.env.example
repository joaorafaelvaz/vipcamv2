# /etc/vipcam/web.env
# Carregado pelo systemd unit vipcam-web.service.
# PORT=3035 vem do unit file (não duplicar aqui).
# Permissões recomendadas: chmod 644 (root:vipcam) — não há segredos.

NODE_ENV=production

# URL pública pela qual o frontend chama a API. Como o nginx do mesmo
# host roteia /api/* para o edge, basta usar o próprio domínio:
NEXT_PUBLIC_API_URL=https://monitoramento.franquiabv.com.br
