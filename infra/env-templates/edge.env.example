# /etc/vipcam/edge.env
# Carregado pelo systemd unit vipcam-edge.service.
# Permissões recomendadas: chmod 640 (root:vipcam).

# ----- Backend (Bun+Hono) -----
# Porta interna — nginx proxy_pass /api/* aponta aqui.
EDGE_PORT=4001
NODE_ENV=production
LOG_LEVEL=info

# API key estática usada pelo middleware de auth do edge.
# GERE com: openssl rand -hex 32
API_KEY=CHANGE_ME_BEFORE_FIRST_BOOT

# ----- Database -----
# Postgres + pgvector via docker-compose (mesmo host).
# Trocar a senha do default 'vipcam' antes de produção:
#   docker exec vipcam-postgres psql -U postgres -c "ALTER USER vipcam PASSWORD 'NOVA';"
DATABASE_URL=postgres://vipcam:CHANGE_ME@127.0.0.1:5432/vipcam

# ----- Câmera Dahua DH-IPC-HFW5442T-ASE -----
# Preencher após Discovery (Task 1.10) confirmar conectividade.
# As três variáveis devem ser todas setadas ou todas vazias (refine no envSchema).
# CAMERA_IP=192.168.1.108
# CAMERA_USER=admin
# CAMERA_PASS=CHANGE_ME

# ----- ERP MySQL local -----
# Preencher quando Onda 2 (Fase 4) estiver implementada e o ERP estiver
# acessível na mesma máquina ou na rede local.
# ERP_MYSQL_URL=mysql://vipcam_reader:CHANGE_ME@127.0.0.1:3306/barbearia_erp

# Queries SQL — defaults assumem schema com tabelas employees/clients/checkins.
# Ajustar via SQL "AS" se seu schema usa nomes diferentes (ver infra/README.md).
# ERP_QUERY_EMPLOYEES="SELECT id, name, role, photo_url, photo_updated_at, is_active FROM employees WHERE is_active = 1"
# ERP_QUERY_CLIENTS="SELECT id, name, phone, is_active FROM clients WHERE is_active = 1"
# ERP_QUERY_CHECKINS_SINCE="SELECT id, client_id, event_type, occurred_at, metadata FROM checkins WHERE occurred_at >= ? ORDER BY occurred_at"

# ----- Match temporal -----
# Janela ±N segundos para vincular face anônima ↔ checkin do ERP.
# Default 300s (±5min). Ajustar conforme volume real (horários de pico podem
# precisar janela menor pra reduzir ambiguidade).
MATCH_WINDOW_SECONDS=300

# ----- Métricas (Onda 5) -----
# Timezone dos buckets de dia/hora do dashboard de métricas. Timestamps são
# UTC; sem isso pico/fluxo deslocam ~3h. Opcional (default abaixo).
# METRICS_TZ=America/Sao_Paulo

# ----- Re-id auto-create on dessync -----
# Se câmera reportar face_id desconhecido pelo nosso DB, default é tratar
# como anônimo. Se true, cria pessoa anônima vinculada — risco de poluição
# de DB se firmware re-usa IDs (ex: factory reset).
REID_AUTOCREATE_ON_DESSYNC=false
