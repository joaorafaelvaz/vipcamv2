[Unit]
Description=VIPCam Web — Next.js frontend (porta 3035, exposta via nginx)
Documentation=https://github.com/<owner>/<repo>
After=network-online.target vipcam-edge.service
Wants=network-online.target

[Service]
Type=simple
User=vipcam
Group=vipcam
WorkingDirectory=/opt/vipcamv2/packages/web
EnvironmentFile=/etc/vipcam/web.env
# PORT=3035 vence sobre defaults internos do Next quando "next start" é chamado sem -p
Environment=PORT=3035
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HOME=/var/lib/vipcam
ExecStart=/usr/local/bin/bun run start
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vipcam-web

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# Next.js precisa escrever em .next/, e Bun em ~/.bun/install/cache,
# node_modules/.cache. Damos write em /opt/vipcamv2 inteiro (escopo dedicado).
ReadWritePaths=/var/log/vipcam /opt/vipcamv2 /var/lib/vipcam /tmp
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
