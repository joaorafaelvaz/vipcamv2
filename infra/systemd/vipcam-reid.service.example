# Renomeie este arquivo para vipcam-reid.service e copie para
# /etc/systemd/system/ APENAS quando a Fase 6 (failover B com InsightFace)
# estiver implementada. Antes disso, edge funciona só com estratégia A
# e este sidecar é desnecessário.

[Unit]
Description=VIPCam Reid — Python sidecar (InsightFace, porta interna 5005)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vipcam
Group=vipcam
WorkingDirectory=/opt/vipcamv2/packages/reid
EnvironmentFile=-/etc/vipcam/reid.env
# uv é vendorizado em /usr/local/bin/uv (mesma estratégia do bun no
# install.sh — uv instalado por-usuário em /root/.local não é acessível
# pro service user 'vipcam' com ProtectHome=read-only).
# HOME = /var/lib/vipcam (movido na Onda 4 D3); InsightFace usa
# $HOME/.insightface p/ o cache do modelo (empírico: ignora INSIGHTFACE_HOME).
# /var/lib/vipcam está em ReadWritePaths.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HOME=/var/lib/vipcam
Environment=INSIGHTFACE_HOME=/var/lib/vipcam/.insightface
# --frozen: usa uv.lock existente sem tentar atualizar. ProtectSystem=strict
# torna /opt read-only, então sem --frozen o uv tenta escrever uv.lock e
# entra em crash loop (descoberto em 2026-05-25, restart counter 80k+).
# Lock deve ser regenerado localmente + commitado quando pyproject.toml mudar.
ExecStart=/usr/local/bin/uv run --frozen uvicorn src.main:app --host 127.0.0.1 --port 5005
# Onda 7 §3.3: pre-warm via /warmup (endpoint dedicado idempotente).
# Sem isso, primeira /embed em runtime sofre ~5,5s de cold-start. Usamos
# --fail aqui — se /warmup retornar 500 (modelo falha em carregar), o
# systemd marca o unit como failed e Restart=on-failure tenta de novo.
# --retry 30 + --retry-connrefused absorve a janela de boot do uvicorn.
ExecStartPost=/usr/bin/curl --fail --silent --output /dev/null \
    --retry 30 --retry-delay 1 --retry-connrefused \
    -X POST http://127.0.0.1:5005/warmup
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vipcam-reid

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/log/vipcam /opt/vipcamv2/packages/reid/.venv /var/lib/vipcam
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
